#! /usr/bin/env bash

DIR=$HOME/usr/git/efl
export PREFIX=/opt/efl
export LOCAL_CONF=$DIR/efl-build.conf

source "$HOME/bin/efl-build-fcts"
[ -r "$LOCAL_CONF" ] && source "$LOCAL_CONF"

declare -a cfgs=(efl e terminology evisum rage ephoto edi echart eclair enigmatic eternity equation xdg)
declare -A build_cfgs=(
["efl",0]="core/efl"
["efl",1]="-Defl-one=true -Doptimization=2 -Dharfbuzz=true -Dbuild-examples=false -Dbuild-tests=false -Ddrm=true -Dwl=true -Dbindings="
["efl",2]="enlightenment/efl"
["e",0]="core/enlightenment"
["e",1]="-Dwl=true"
["e",2]="enlightenment/enlightenment"
["terminology",0]="apps/terminology"
["terminology",2]="enlightenment/terminology"
["evisum",0]="apps/evisum"
["evisum",2]="enlightenment/evisum"
["rage",0]="apps/rage"
["rage",2]="enlightenment/rage"
["ephoto",0]="apps/ephoto"
["ephoto",2]="enlightenment/ephoto"
["edi",0]="apps/edi"
["edi",2]="enlightenment/edi"
["echart",0]="apps/echart"
["echart",2]="vtorri/echart"
["eclair",0]="apps/eclair"
["eclair",2]="netstar/eclair"
["enigmatic",0]="apps/enigmatic"
["enigmatic",2]="netstar/enigmatic"
["eternity",0]="apps/eternity"
["eternity",2]="netstar/eternity"
["equation",0]="apps/equation"
["equation",2]="netstar/equation"
["xdg",0]="apps/xdg-desktop-portal-efl"
["xdg",2]="raster/xdg-desktop-portal-efl"

# ["clouseau",0]="tools/clouseau"
# ["eruler",0]="apps/eruler"
# ["extra",0]="apps/extra"
# ["extra",2]="enlightenment/extra"
# ["profiler",0]="devs/nikawhite/efl_profiler_viewer"
# ["enventor",0]="tools/enventor"
# ["eflete",0]="tools/eflete"
# ["eflete",1]="--enable-enventor"
# ["theme_viewer",0]="tools/elm-theme-viewer"
)

# build_cfgs[cfg,2] is the repo: either a full url, or a path relative to $GIT_BASE
GIT_BASE=${GIT_BASE:-"ssh://git@git.enlightenment.org:9990"}

function repo_url()
{
  local repo=$1
  case "$repo" in
    *://*|*@*:*) echo "$repo" ;;
    *) echo "$GIT_BASE/${repo%.git}.git" ;;
  esac
}

function main_to_master()
{
  local src_dir=$1
  if git -C "$src_dir" show-ref --verify --quiet refs/heads/main \
    && ! git -C "$src_dir" show-ref --verify --quiet refs/heads/master
  then
    echo -e "==== rename local branch ${GREEN}main$RESET -> ${GREEN}master$RESET"
    git -C "$src_dir" branch -m main master || fatal "git branch -m main master"
  fi
}

function clone_missing()
{
  local src_dir=$1
  local repo=$2
  [ -e "$src_dir/.git" ] && return 0
  [ -z "$repo" ] && fatal "no repo defined for $src_dir"
  local url
  url=$(repo_url "$repo")
  echo -e "\n==== clone $PURPLE$src_dir$RESET from $GREEN$url$RESET"
  mkdir -p "${src_dir%/*}"
  git clone "$url" "$src_dir" && { main_to_master "$src_dir"; return 0; }
  [[ "$url" == ssh://* ]] || fatal "git clone $url"
  local alt=${url/#ssh:\/\//}
  alt=${alt/:9990\//\/}
  rm -rf "$src_dir"
  echo -e "\n==== ssh clone failed, retry from $GREEN$alt$RESET"
  git clone "$alt" "$src_dir" || fatal "git clone $alt"
  main_to_master "$src_dir"
}

function build_cfg()
{
  cfg=$1
  local src_dir=${build_cfgs["$cfg",0]}
  local extra=""
  [ -e "$src_dir/.git" ] || extra="FORCE_BUILD"
  clone_missing "$src_dir" "${build_cfgs["$cfg",2]}"
  build "$src_dir" "${build_cfgs["$cfg",1]}" "$extra"
}

function build_all()
{
  for cfg in "${cfgs[@]}"
  do
    build_cfg "$cfg"
  done
}

cd "$DIR" || exit 1
built=0
get_sudo_pwd
for arg in "$@"
do
  for cfg in "${cfgs[@]}"
  do
    [ "$arg" = "$cfg" ] && built=1 && build_cfg "$cfg"
  done
done
[ $built -eq 0 ] && build_all
echo -e "\n==== DONE\n"
