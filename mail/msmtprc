# Set default values for all following accounts.
defaults
logfile /tmp/msmtp.log
from jeremy@asynk.ch

account asynk
auth on
tls on
user jeyzu@asynk.ch
passwordeval gpg --no-tty -q -d ~/.config/msmtp/msmtp-password.gpg
# submissions (465): TLS from the first byte; port 25 is for other mail
# servers only. The certificate is Let's Encrypt (asynk.ch): checked.
tls_starttls off
tls_certcheck on
tls_trust_file system
host asynk.ch
port 465

account heraeus
from deb000@heraeus.com
host mailto.heraeus.com

account default: asynk
